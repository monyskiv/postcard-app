# Seed credentials for the two admin accounts created by the V4 Flyway
# migration. These are read once, at migration time, to build the seeded
# rows. If unset, insecure local-dev-only defaults are used instead (see
# README.md) — always set real values before any real deployment.
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=change-me
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=change-me

# Signing secret for admin login JWTs (HS256, so use 32+ random bytes).
# If unset, an insecure default is used (see application.yml) — always set
# a real value before any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# Cloudflare R2 (S3-compatible) bucket used for postcard image uploads.
# ACCOUNT_ID/ACCESS_KEY_ID/SECRET_ACCESS_KEY are used to build the S3 client
# and authenticate uploads; BUCKET_NAME is the target bucket.
# PUBLIC_BASE_URL is the hostname images are served from — R2's own S3 API
# endpoint (built from ACCOUNT_ID) is NOT public, so this must be either the
# bucket's "Public Development URL" (https://pub-<hash>.r2.dev) or a custom
# domain you've attached to the bucket in the Cloudflare dashboard. It's
# concatenated with the object key to build the URL stored on each postcard.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=postcards
R2_PUBLIC_BASE_URL=https://pub-change-me.r2.dev

# Optional - text baked into the watermark applied to every uploaded image.
# Defaults to "Ukrainian Postcards" (see application.yml) if unset.
WATERMARK_TEXT=Ukrainian Postcards
