# Seed credentials for the two admin accounts created by the V4 Flyway
# migration. These are read once, at migration time, to build the seeded
# rows. If unset, insecure local-dev-only defaults are used instead (see
# README.md) — always set real values before any real deployment.
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=change-me
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=change-me

# Signing secret for admin login JWTs (HS256, so use 32+ random bytes).
# If unset, an insecure default is used (see application.yml) — always set
# a real value before any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# Cloudflare stuff
R2_ACCOUNT_ID=1111
R2_ACCESS_KEY_ID=1111
R2_SECRET_ACCESS_KEY=1111
R2_BUCKET_NAME=default
R2_PUBLIC_BASE_URL=your_r2_public_url_here
